{
  "name": "backend-boilerplate",
  "version": "1.0.0",
  "description": "Express.js and MongoDB backend boilerplate with JWT authentication, multi-device sessions, dual logging, and audit trail",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "dev:admin": "pnpm --filter @boilerplate/admin dev",
    "build:admin": "pnpm --filter @boilerplate/admin build",
    "build:frontend": "pnpm --filter \"@boilerplate/*\" build",
    "screenshots": "node scripts/take-screenshots.js",
    "start": "node src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "chalk": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "http-status": "^2.1.0",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongoose": "^9.9.5",
    "mongoose-delete": "^1.0.7",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.1",
    "socket.io": "^4.8.3",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.2",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.10.0"
  }
}
