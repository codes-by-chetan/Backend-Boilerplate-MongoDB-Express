# ==============================================================================
# Application Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000
SELF_HOST_URL=http://localhost:5000
CORS_ORIGIN=*

# ==============================================================================
# Database Configuration (MongoDB)
# ==============================================================================
MONGODB_URI=mongodb://localhost:27017
DB_NAME=license_manager_pos

# ==============================================================================
# Authentication & JWT Configuration
# ==============================================================================
ACCESS_TOKEN_SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRY=2d

# ==============================================================================
# Cloudinary Configuration (Optional - Media Storage)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=UPLOADS

# ==============================================================================
# OAuth Configuration (Optional - Social Authentication)
# ==============================================================================
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

META_CLIENT_ID=your_meta_app_id
META_CLIENT_SECRET=your_meta_app_secret

# ==============================================================================
# Email Configuration (Optional - Nodemailer)
# ==============================================================================
EMAIL_SERVICE=gmail
EMAIL_ID=your_email@gmail.com
EMAIL_PASSKEY=your_email_app_password
