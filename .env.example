# ==============================================================================
# Application Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000
# Backend API Base URL
SELF_HOST_URL=http://localhost:5000
# Frontend Client URL (Defaults to backend-hosted React Admin SPA at /admin, or custom frontend)
CLIENT_URL=http://localhost:5000/admin
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ==============================================================================
# Database Configuration (MongoDB)
# ==============================================================================
MONGODB_URI=mongodb://localhost:27017
DB_NAME=backend_boilerplate

# ==============================================================================
# Authentication & JWT Configuration (Dual-Token Security Architecture)
# ==============================================================================
# Access Token: Short-lived token for authorization header (Recommended: 15m)
ACCESS_TOKEN_SECRET_KEY=your_super_secret_access_jwt_key_here
ACCESS_TOKEN_EXPIRY=15m

# Refresh Token: Long-lived token for session renewal (Recommended: 7d)
REFRESH_TOKEN_SECRET_KEY=your_super_secret_refresh_jwt_key_here
REFRESH_TOKEN_EXPIRY=7d

# Confidential Payload Encryption (AES-256-GCM 32-byte hex key for request log bodies)
LOG_ENCRYPTION_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Cookie Security (For storing Refresh Token in HttpOnly cookie if applicable)
COOKIE_SECRET=your_cookie_signing_secret_here
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ==============================================================================
# Threat Mitigation & Rate Limiting Thresholds (Security Blueprint Specs)
# ==============================================================================
# Maximum failed password attempts before account lockout (Default: 3)
MAX_LOGIN_ATTEMPTS=3
# Account lockout duration in hours (Default: 24)
LOCKOUT_DURATION_HOURS=24
# Minimum cooldown period between transactional emails in seconds (Default: 60)
EMAIL_COOLDOWN_SECONDS=60
# Sliding-window rate limit for login endpoint (hits/minute, Default: 15)
RATE_LIMIT_LOGIN_MAX=15
# Sliding-window rate limit for password reset/unlock email requests (hits/minute, Default: 5)
RATE_LIMIT_EMAIL_MAX=5

# ==============================================================================
# Admin User Bootstrap Configuration
# ==============================================================================
BOOTSTRAP_ADMIN=true
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ==============================================================================
# Email & SMTP Configuration (Nodemailer)
# ==============================================================================
# Method 1: Preconfigured service (e.g. gmail, outlook, sendgrid)
EMAIL_SERVICE=gmail
EMAIL_ID=your_email@gmail.com
EMAIL_PASSKEY=your_email_app_password
EMAIL_FROM="Enterprise Security <noreply@yourdomain.com>"

# Method 2: Custom SMTP Server (Optional - used if EMAIL_SERVICE is empty)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# ==============================================================================
# Forensic Geolocation & Threat Intelligence (Optional)
# ==============================================================================
# Used to map IP to Country, City, Region in brute-force intrusion notification emails
IPINFO_API_TOKEN=your_ipinfo_api_token_here

# ==============================================================================
# Cloudinary Configuration (Optional - Media Storage)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=UPLOADS

# ==============================================================================
# OAuth Configuration (Optional - Social Authentication)
# ==============================================================================
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

META_CLIENT_ID=your_meta_app_id
META_CLIENT_SECRET=your_meta_app_secret
